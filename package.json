{
  "name": "@dcx-ng-components/source",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "start": "nx serve",
    "start-web": "nx serve dcx-web-app",
    "start-storybook": "npx nx storybook dcx-ng-lib",
    "start-storybook:web": "nx storybook dcx-web-lib",
    "build": "nx build dcx-ng-lib",
    "build-storybook": "nx build-storybook dcx-ng-lib",
    "test": "nx run-many --target=test --all -- --coverage --coverageDirectory='coverage/libs'",
    "lint": "nx lint dcx-ng-lib",
    "lint-fix": "nx lint dcx-ng-lib --fix",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "verify:commit": "npm run lint",
    "verify:push": "nx affected -t lint test build build-storybook && npm run clean:dist",
    "deploy:main": "gh-pages -d dist/storybook/dcx-ng-lib -m 'Deploy main' -b gh-pages --dest main --add --repo https://x-access-token:${GITHUB_TOKEN}@github.com/${GITHUB_REPOSITORY}.git",
    "deploy:develop": "gh-pages -d dist/storybook/dcx-ng-lib -m 'Deploy develop' -b gh-pages --dest develop --add --repo https://x-access-token:${GITHUB_TOKEN}@github.com/${GITHUB_REPOSITORY}.git",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,html,scss}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.13",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.13",
    "@angular/core": "20.3.13",
    "@angular/forms": "20.3.13",
    "@angular/platform-browser": "20.3.13",
    "@angular/platform-browser-dynamic": "20.3.13",
    "@angular/router": "20.3.13",
    "lit": "^3.3.3",
    "rxjs": "~7.8.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2100.0",
    "@angular-devkit/build-angular": "20.3.9",
    "@angular-devkit/core": "^20.3.11",
